{
  "name": "@zllling/react-previewer",
  "version": "0.1.0",
  "description": "A React component for live code preview with compilation and error handling",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "style": "dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./rspack-browser-worker": {
      "import": "./dist/rspack-browser-worker.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib",
    "typecheck": "tsc -b",
    "build:page": "npm run typecheck && vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "prepack": "npm run build:lib",
    "package:pack": "node scripts/pack-package.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "check:page": "node scripts/check-page.mjs",
    "check": "npm run lint && npm test && npm run build && npm run build:page && npm run check:page && npm run test:package"
  },
  "keywords": [
    "react",
    "preview",
    "compiler",
    "live-editor",
    "code-preview",
    "typescript",
    "jsx"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ForXd/react-previewer.git"
  },
  "bugs": {
    "url": "https://github.com/ForXd/react-previewer/issues"
  },
  "homepage": "https://github.com/ForXd/react-previewer#readme",
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/standalone": "^8.0.4",
    "@babel/types": "^8.0.4",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@rspack/browser": "^2.2.2",
    "@swc/helpers": "^0.5.23"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@monaco-editor/react": "^4.7.0",
    "@testing-library/react": "^16.3.3",
    "@types/babel__standalone": "^7.1.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.14"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
